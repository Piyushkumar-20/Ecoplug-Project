# Configure these values in your local .env file; do not commit secrets.
FRONTEND_ORIGIN=http://localhost:5173
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_DAYS=7
MAX_SESSION_DAYS=30
BCRYPT_ROUNDS=10
REFRESH_COOKIE_NAME=ecoplug_refresh
# JWT_SECRET=replace-with-a-long-random-secret

# Shared secret used by the CMS to notify the backend after a session is saved as COMPLETED.
CMS_BILLING_API_KEY=replace-with-a-long-random-secret
